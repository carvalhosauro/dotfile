# Ghostty — Catppuccin Frappé
# Inspired by Zellij's default theme

# ── Fonts ──────────────────────────────────────────────────────────────────
font-family = FiraCode Nerd Font Propo
font-style = Regular
font-family-bold = FiraCode Nerd Font Propo
font-style-bold = Bold
font-family-italic = Victor Mono
font-style-italic = Italic
font-family-bold-italic = Victor Mono
font-style-bold-italic = Bold Italic
font-size = 12.5
font-feature = +liga
font-feature = +calt

# ── Colors — Catppuccin Mocha ──────────────────────────────────────────────
background = #1e1e2e
foreground = #cdd6f4

# Normal
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de

# Bright
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Cursor — Rosewater
cursor-color = #f5e0dc
cursor-text = #1e1e2e
cursor-style = block
cursor-style-blink = true

# Selection — Surface1
selection-background = #45475a
selection-foreground = #cdd6f4

# ── Window ─────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-decoration = server
background-opacity = 0.8
background-blur-radius = 20

# ── Terminal behaviour ──────────────────────────────────────────────────────
bold-is-bright = true
scrollback-limit = 10000
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Shell integration ───────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Keybinds ────────────────────────────────────────────────────────────────
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
